// ── Design tokens (modern-minimal) ──
// bg:        #fafbfc   surface:  #ffffff
// fg:        #1a2538   muted:    #6b7c93
// border:    #e5e9ee   accent:   #3b82f6
// success:   #22c55e   warn:     #f59e0b

import { ListView } from "std-widgets.slint";

// ── Data model ──
export struct DeviceRowData {
    row-kind-label: string,
    virtual-name: string,
    physical-name: string,
    interface-id: string,
    can-use-for-rule: bool,
    row-kind: string,
    status: string,
}

// ── Status badge ──
component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <bool> ok: true;

    width: 72px;
    height: 26px;
    border-radius: 13px;
    background: ok ? #ecfdf5 : #fffbeb;

    Rectangle {
        x: 12px;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: ok ? #22c55e : #f59e0b;
    }

    Text {
        x: 26px;
        text: root.label;
        color: ok ? #15803d : #b45309;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        height: parent.height;
        letter-spacing: -0.2px;
    }
}

// ── Device table component ──
export component DeviceTable inherits Rectangle {
    in property <[DeviceRowData]> rows;
    callback row-selected(index: int);

    border-radius: 10px;
    border-width: 1px;
    border-color: #e5e9ee;
    background: #ffffff;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        // ── Header ──
        Rectangle {
            height: 40px;
            background: #fafbfc;

            HorizontalLayout {
                spacing: 0px;

                Rectangle { width: 16px; }

                Rectangle {
                    width: 190px;
                    Text {
                        text: "设备类型";
                        color: #6b7c93;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        x: 6px;
                        height: parent.height;
                        width: parent.width;
                    }
                }

                Rectangle {
                    width: 170px;
                    Text {
                        text: "虚拟设备";
                        color: #6b7c93;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        height: parent.height;
                        width: parent.width;
                    }
                }

                Rectangle {
                    width: 165px;
                    Text {
                        text: "物理设备";
                        color: #6b7c93;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        height: parent.height;
                        width: parent.width;
                    }
                }

                Rectangle {
                    width: 140px;
                    Text {
                        text: "接口 ID";
                        color: #6b7c93;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        height: parent.height;
                        width: parent.width;
                    }
                }

                Rectangle {
                    width: 105px;
                    Text {
                        text: "状态";
                        color: #6b7c93;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        height: parent.height;
                        width: parent.width;
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: #e5e9ee;
            }
        }

        // ── Empty state ──
        if root.rows.length == 0 : Rectangle {
            background: white;
            min-height: 200px;

            VerticalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "暂无设备数据";
                    color: #1a2538;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    letter-spacing: -0.2px;
                }

                Text {
                    text: "连接 USB 串口设备后点击「刷新」按钮";
                    color: #6b7c93;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }

        // ── Data rows ──
        if root.rows.length > 0 : ListView {
            for row[idx] in root.rows : Rectangle {
                height: 46px;
                background: touch.has-hover ? #f9fafb : white;

                animate background { duration: 120ms; }

                HorizontalLayout {
                    spacing: 0px;

                    Rectangle { width: 16px; }

                    // Kind column: indicator dot + label
                    Rectangle {
                        width: 190px;

                        // Colored indicator dot
                        Rectangle {
                            x: 6px;
                            y: (parent.height - 8px) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: row.row-kind == "virtual" ? #3b82f6 : #22c55e;
                        }

                        Text {
                            x: 22px;
                            text: row.row-kind-label;
                            color: #1a2538;
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                    }

                    // Virtual device
                    Rectangle {
                        width: 170px;
                        Text {
                            text: row.row-kind == "physical" ? "—" : row.virtual-name;
                            color: row.row-kind == "physical" ? #6b7c93 : #1a2538;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            height: parent.height;
                            width: parent.width;
                            overflow: elide;
                        }
                    }

                    // Physical device
                    Rectangle {
                        width: 165px;
                        Text {
                            text: row.physical-name;
                            color: #1a2538;
                            font-size: 12px;
                            font-family: "monospace";
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            height: parent.height;
                            width: parent.width;
                            overflow: elide;
                        }
                    }

                    // Interface ID
                    Rectangle {
                        width: 140px;
                        Text {
                            text: row.interface-id;
                            color: row.can-use-for-rule ? #1a2538 : #f59e0b;
                            font-size: 12px;
                            font-family: "monospace";
                            font-weight: row.can-use-for-rule ? 400 : 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            height: parent.height;
                            width: parent.width;
                            overflow: elide;
                        }
                    }

                    // Status badge
                    Rectangle {
                        width: 105px;

                        StatusBadge {
                            x: (parent.width - 72px) / 2;
                            y: (parent.height - 26px) / 2;
                            label: row.status;
                            ok: row.status == "可用";
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.row-selected(idx);
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    x: 16px;
                    width: parent.width - 32px;
                    height: 1px;
                    background: #f5f6f7;
                }
            }
        }
    }
}
