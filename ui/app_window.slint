import { Button, GroupBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { DeviceTable, DeviceRowData } from "./device_table.slint";

export component MainWindow inherits Window {
    title: "USB 串口映射工具";
    width: 960px;
    height: 700px;
    background: #eef3f8;

    in-out property <string> virtual-name-input;
    in-out property <string> physical-id-input;
    in-out property <string> rule-file-input;
    in property <string> status-message;
    in property <bool> status-is-error;
    in property <string> current-filter-label;
    in property <[DeviceRowData]> device-rows;

    callback request-refresh();
    callback select-all-filter();
    callback select-virtual-filter();
    callback select-physical-filter();
    callback use-row-for-rule(index: int);
    callback save-rule-requested();

    VerticalBox {
        padding: 20px;
        spacing: 16px;

        Rectangle {
            border-radius: 14px;
            background: white;
            border-color: #d9e1ec;
            border-width: 1px;
            min-height: 92px;

            VerticalBox {
                padding: 18px;
                spacing: 8px;

                Text {
                    text: "USB 串口映射";
                    color: #132238;
                    font-size: 24px;
                    font-weight: 700;
                }

                Text {
                    text: "上半部分查看当前 /dev 设备映射，下半部分生成或更新 udev 规则。";
                    color: #4a6077;
                    wrap: word-wrap;
                }
            }
        }

        GroupBox {
            title: "设备列表";

            VerticalBox {
                spacing: 12px;

                HorizontalBox {
                    spacing: 10px;

                    Button {
                        text: "刷新设备列表";
                        clicked => { root.request-refresh(); }
                    }

                    Button {
                        text: "显示全部";
                        clicked => { root.select-all-filter(); }
                    }

                    Button {
                        text: "仅虚拟链接";
                        clicked => { root.select-virtual-filter(); }
                    }

                    Button {
                        text: "仅物理设备";
                        clicked => { root.select-physical-filter(); }
                    }

                    Text {
                        text: "当前过滤: " + root.current-filter-label;
                        color: #44566c;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "提示：点击列表任意行，会把该行的接口 ID 自动带入下方规则表单。";
                    color: #4a6077;
                    wrap: word-wrap;
                }

                DeviceTable {
                    rows: root.device-rows;
                    row-selected(index) => {
                        root.use-row-for-rule(index);
                    }
                }
            }
        }

        GroupBox {
            title: "规则表单";

            VerticalBox {
                spacing: 12px;

                Text {
                    text: "规则会按物理接口 ID 定位设备，并在 /dev 下创建稳定的符号链接。";
                    color: #4a6077;
                    wrap: word-wrap;
                }

                HorizontalBox {
                    spacing: 12px;

                    VerticalBox {
                        spacing: 6px;

                        Text {
                            text: "虚拟设备名称";
                            color: #223247;
                            font-weight: 600;
                        }

                        LineEdit {
                            text <=> root.virtual-name-input;
                            placeholder-text: "例如 ttyCAN";
                        }
                    }

                    VerticalBox {
                        spacing: 6px;

                        Text {
                            text: "物理接口 ID";
                            color: #223247;
                            font-weight: 600;
                        }

                        LineEdit {
                            text <=> root.physical-id-input;
                            placeholder-text: "例如 1-4.5:1.0";
                        }
                    }
                }

                VerticalBox {
                    spacing: 6px;

                    Text {
                        text: "规则文件路径";
                        color: #223247;
                        font-weight: 600;
                    }

                    LineEdit {
                        text <=> root.rule-file-input;
                        placeholder-text: "/etc/udev/rules.d/relia.rules";
                    }
                }

                HorizontalBox {
                    spacing: 12px;

                    Button {
                        text: "保存或更新规则";
                        clicked => { root.save-rule-requested(); }
                    }

                    Text {
                        text: "保存后请重载 udev 规则。";
                        color: #4a6077;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            border-radius: 10px;
            background: root.status-is-error ? #fff1f0 : #eff9f0;
            border-color: root.status-is-error ? #f3b5ad : #b9dfbc;
            border-width: 1px;
            min-height: 60px;

            Text {
                text: root.status-message;
                color: root.status-is-error ? #8f2d23 : #215b2d;
                wrap: word-wrap;
                x: 14px;
                y: 12px;
                width: parent.width - 28px;
            }
        }
    }
}
