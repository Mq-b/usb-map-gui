import { LineEdit, ScrollView } from "std-widgets.slint";
import { DeviceTable, DeviceRowData } from "./device_table.slint";

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;

    min-width: primary ? 160px : 120px;
    height: 36px;
    border-radius: 6px;
    border-width: 1px;
    border-color: primary ? touch.has-hover ? #1a4fd6 : #2f63f6 : touch.has-hover ? #b8c4d6 : #d7deea;
    background: primary ? touch.has-hover ? #1a4fd6 : #2f63f6 : touch.has-hover ? #f8fafc : white;

    animate border-color, background { duration: 150ms; }

    Text {
        text: root.label;
        color: root.primary ? white : #243750;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component FilterButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    min-width: 100px;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: active ? #2f63f6 : touch.has-hover ? #b8c4d6 : #d7deea;
    background: active ? #eef2ff : touch.has-hover ? #f8fafc : white;

    animate border-color, background { duration: 150ms; }

    Text {
        text: root.label;
        color: active ? #2f63f6 : #475569;
        font-size: 13px;
        font-weight: active ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component FormField inherits Rectangle {
    in property <string> field-label;
    in-out property <string> field-value;
    in property <string> placeholder;

    vertical-stretch: 0;
    background: transparent;

    VerticalLayout {
        spacing: 4px;

        Text {
            text: root.field-label;
            color: #374151;
            font-size: 13px;
            font-weight: 600;
        }

        Rectangle {
            height: 36px;
            border-radius: 6px;
            border-width: 1px;
            border-color: #d1d5db;
            background: white;

            LineEdit {
                text <=> root.field-value;
                placeholder-text: root.placeholder;
                x: 10px;
                y: 6px;
                width: parent.width - 20px;
                height: parent.height - 12px;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "USB Serial Mapper";
    min-width: 900px;
    min-height: 640px;
    background: #f9fafb;

    in-out property <string> virtual-name-input;
    in-out property <string> physical-id-input;
    in-out property <string> rule-file-input;
    in property <string> status-message;
    in property <bool> status-is-error;
    in property <string> current-filter-label;
    in property <[DeviceRowData]> device-rows;

    callback request-refresh();
    callback select-all-filter();
    callback select-virtual-filter();
    callback select-physical-filter();
    callback use-row-for-rule(index: int);
    callback save-rule-requested();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Toolbar
        HorizontalLayout {
            spacing: 8px;
            alignment: stretch;

            Text {
                text: "USB Serial Mapper";
                color: #111827;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            ActionButton {
                primary: true;
                label: "刷新设备列表";
                clicked => { root.request-refresh(); }
            }
        }

        // Filter bar
        HorizontalLayout {
            spacing: 6px;

            FilterButton {
                label: "全部";
                active: root.current-filter-label == "全部设备";
                clicked => { root.select-all-filter(); }
            }

            FilterButton {
                label: "虚拟链接";
                active: root.current-filter-label == "仅虚拟链接";
                clicked => { root.select-virtual-filter(); }
            }

            FilterButton {
                label: "物理设备";
                active: root.current-filter-label == "仅物理设备";
                clicked => { root.select-physical-filter(); }
            }

            Rectangle {
                horizontal-stretch: 1;

                Text {
                    text: root.current-filter-label;
                    color: #9ca3af;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        // Device table
        DeviceTable {
            vertical-stretch: 1;
            rows: root.device-rows;
            row-selected(index) => {
                root.use-row-for-rule(index);
            }
        }

        // Rule form card
        Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: #e5e7eb;
            background: white;
            vertical-stretch: 0;
            clip: true;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: stretch;

                    Text {
                        text: "udev 规则";
                        color: #111827;
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    ActionButton {
                        primary: true;
                        label: "添加规则";
                        clicked => { root.save-rule-requested(); }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    FormField {
                        field-label: "虚拟设备名称";
                        field-value <=> root.virtual-name-input;
                        placeholder: "例如 ttyCAN";
                        horizontal-stretch: 1;
                    }

                    FormField {
                        field-label: "物理接口 ID";
                        field-value <=> root.physical-id-input;
                        placeholder: "例如 1-4.5:1.0";
                        horizontal-stretch: 1;
                    }

                    FormField {
                        field-label: "规则文件路径";
                        field-value <=> root.rule-file-input;
                        placeholder: "/etc/udev/rules.d/relia.rules";
                        horizontal-stretch: 2;
                    }
                }
            }
        }

        // Status bar
        Rectangle {
            height: 32px;
            border-radius: 6px;
            background: root.status-is-error ? #fef2f2 : #f0fdf4;

            Text {
                text: root.status-message;
                color: root.status-is-error ? #dc2626 : #16a34a;
                font-size: 13px;
                vertical-alignment: center;
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                overflow: elide;
            }
        }
    }
}
